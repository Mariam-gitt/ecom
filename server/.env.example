# Copy this file to .env and fill in the real values below.
# .env is gitignored — never commit real secrets.

PORT=4000

# --- Voice search (Groq — free tier, no card required) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here
# Small/fast model — plenty for a narrow extraction task like this.
GROQ_MODEL=llama-3.1-8b-instant

# --- Payments (simulated gateway — no signup, no keys needed) ---
# Stripe doesn't support Pakistan for account creation, and real local
# gateways (Safepay, GoPayFast, etc.) require business KYC to get even
# test keys — so payments here are simulated for now. Nothing to
# configure. See server/src/routes/payments.js for how it works and
# how to swap in a real gateway later.

# --- Admin dashboard ---
# A single shared password protecting /admin and the order-management
# API routes. Pick anything — this is NOT a real multi-user auth
# system, just a shared secret for a solo/small project. See
# server/src/middleware/adminAuth.js for exactly how it's checked.
ADMIN_PASSWORD=change-me

# Where the frontend is allowed to call this API from (CORS), and
# where the payment gateway should redirect the customer back to.
CLIENT_ORIGIN=http://localhost:5173
